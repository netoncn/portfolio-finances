# Google OAuth Credentials
GOOGLE_CLIENT_ID=99999
GOOGLE_CLIENT_SECRET=99999

# Firebase Client (Browser) - Público
NEXT_PUBLIC_FIREBASE_API_KEY=99999
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=99999
NEXT_PUBLIC_FIREBASE_PROJECT_ID=99999
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=99999
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=99999
NEXT_PUBLIC_FIREBASE_APP_ID=99999

# Firebase Admin (Server) - Privado
FIREBASE_PROJECT_ID=99999
FIREBASE_CLIENT_EMAIL=99999
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\99999\n-----END PRIVATE KEY-----\n"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=99999
NEXTAUTH_DEBUG=false

# AI
# Escolha o provedor
LLM_PROVIDER=openai  # ou anthropic ou google

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini)
GOOGLE_AI_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-flash

# AI Usage Quota (optional - se não definir, usa os limites do plano free)
# Defina false para desabilitar o sistema de quota completamente
AI_QUOTA_ENABLED=true
# Limites mensais (deixe em branco para usar padrões do plano free)
AI_QUOTA_MAX_REQUESTS_PER_MONTH=1000  # Número máximo de requisições por mês
AI_QUOTA_MAX_TOKENS_PER_MONTH=500000  # Número máximo de tokens por mês
AI_QUOTA_MAX_COST_PER_MONTH=1000      # Custo máximo em centavos (1000 = $10.00)

# Environment
NODE_ENV=development
SKIP_ENV_VALIDATION=false
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Features Toggle
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true