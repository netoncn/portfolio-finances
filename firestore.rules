rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------- Helpers -------------------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerId(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Documento existente pertence ao usuário autenticado
    function isOwnerDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Novo documento (create/update) pertence ao usuário autenticado
    function isOwnerNew() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Garante userId imutável em updates
    function sameUserIdOnUpdate() {
      return request.method != 'update'
        || (resource.data.userId == request.resource.data.userId
            && resource.data.userId == request.auth.uid);
    }

    // Ref check: account pertence ao usuário
    function accountBelongsToUser(accountId) {
      return accountId != null
        && exists(/databases/$(database)/documents/accounts/$(accountId))
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.userId == request.auth.uid;
    }

    // Ref check: investment account pertence ao usuário
    function invAccountBelongsToUser(invAccountId) {
      return invAccountId != null
        && exists(/databases/$(database)/documents/investment_accounts/$(invAccountId))
        && get(/databases/$(database)/documents/investment_accounts/$(invAccountId)).data.userId == request.auth.uid;
    }

    // Ref check: points program pertence ao usuário
    function pointsProgramBelongsToUser(programId) {
      return programId != null
        && exists(/databases/$(database)/documents/points_programs/$(programId))
        && get(/databases/$(database)/documents/points_programs/$(programId)).data.userId == request.auth.uid;
    }

    /* -------------------- Users -------------------- */
    match /users/{uid} {
      allow create: if isOwnerId(uid);                // userId == auth.uid
      allow read, update: if isOwnerId(uid);
      allow delete: if false;                         // opcional: nunca deletar user
    }

    /* -------------------- Accounts (carteiras/contas) -------------------- */

    // Valida tipos de conta permitidos
    function isValidAccountType(type) {
      return type in [
        'card_credit',
        'card_debit',
        'prepaid',
        'wallet_cash',
        'bank_checking',
        'bank_savings'
      ];
    }

    // Valida bandeiras de cartão permitidas
    function isValidCardBrand(brand) {
      return brand in [
        'visa',
        'mastercard',
        'amex',
        'elo',
        'hipercard',
        'vr',
        'sodexo',
        'alelo',
        'other'
      ];
    }

    // Verifica se é um tipo de cartão
    function isCardType(type) {
      return type in ['card_credit', 'card_debit', 'prepaid'];
    }

    // Verifica se é cartão de crédito
    function isCreditCard(type) {
      return type == 'card_credit';
    }

    // Verifica se é conta bancária ou carteira
    function isBankOrWallet(type) {
      return type in ['wallet_cash', 'bank_checking', 'bank_savings'];
    }

    // Valida campos obrigatórios de account
    function hasRequiredAccountFields(data) {
      return data.keys().hasAll(['userId', 'name', 'accountType', 'currency', 'createdAt', 'updatedAt', 'archived'])
        && data.userId is string
        && data.name is string
        && data.name.size() >= 2
        && isValidAccountType(data.accountType)
        && data.currency == 'BRL'
        && data.createdAt is int
        && data.updatedAt is int
        && data.archived is bool;
    }

    // Valida billing para cartão de crédito
    function hasValidBilling(data) {
      return data.billing is map
        && data.billing.keys().hasAll(['closingDay', 'dueDay'])
        && data.billing.closingDay is int
        && data.billing.closingDay >= 1
        && data.billing.closingDay <= 28
        && data.billing.dueDay is int
        && data.billing.dueDay >= 1
        && data.billing.dueDay <= 28
        && data.billing.closingDay != data.billing.dueDay
        && (!data.billing.keys().hasAny(['creditLimit']) || data.billing.creditLimit is int)
        && (!data.billing.keys().hasAny(['availableCredit']) || data.billing.availableCredit is int);
    }

    // Valida coerência de campos baseado no tipo de conta
    function accountFieldsAreCoherent(data) {
      let accountType = data.accountType;
      let isCard = isCardType(accountType);
      let isCredit = isCreditCard(accountType);
      let isBankWallet = isBankOrWallet(accountType);

      return (
        // Cartões devem ter cardBrand
        (!isCard || (data.keys().hasAny(['cardBrand']) && isValidCardBrand(data.cardBrand)))
        // Cartões de crédito devem ter billing
        && (!isCredit || (data.keys().hasAny(['billing']) && hasValidBilling(data)))
        // Contas bancárias/carteiras não devem ter billing
        && (!isBankWallet || !data.keys().hasAny(['billing']))
        // Contas bancárias/carteiras não devem ter cardBrand
        && (!isBankWallet || !data.keys().hasAny(['cardBrand']))
        // Contas bancárias/carteiras não devem ter last4
        && (!isBankWallet || !data.keys().hasAny(['last4']) || data.last4 == '')
        // last4 se presente deve ter 2-4 dígitos
        && (!data.keys().hasAny(['last4']) || data.last4 == '' || (data.last4 is string && data.last4.size() >= 2 && data.last4.size() <= 4))
        // benefits se presente deve ser um map
        && (!data.keys().hasAny(['benefits']) || data.benefits is map)
      );
    }

    // Valida que campos imutáveis não foram alterados em update
    function accountImmutableFieldsUnchanged() {
      return request.method != 'update' || (
        resource.data.userId == request.resource.data.userId
        && resource.data.createdAt == request.resource.data.createdAt
      );
    }

    match /accounts/{id} {
      allow create: if isOwnerNew()
        && hasRequiredAccountFields(request.resource.data)
        && accountFieldsAreCoherent(request.resource.data);

      allow read: if isOwnerDoc();

      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && accountImmutableFieldsUnchanged()
        && hasRequiredAccountFields(request.resource.data)
        && accountFieldsAreCoherent(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Transactions (inclui parceladas) -------------------- */

    // Valida tipos de transação permitidos
    function isValidTransactionType(type) {
      return type in ['expense', 'income', 'transfer'];
    }

    // Valida status de transação permitidos
    function isValidTransactionStatus(status) {
      return status in ['pending', 'posted', 'paid', 'canceled'];
    }

    // Valida campos obrigatórios de transaction
    function hasRequiredTransactionFields(data) {
      return data.keys().hasAll(['userId', 'accountId', 'date', 'description', 'amount', 'type', 'status', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.accountId is string
        && data.date is int
        && data.description is string
        && data.description.size() >= 1
        && data.amount is int
        && isValidTransactionType(data.type)
        && isValidTransactionStatus(data.status)
        && data.createdAt is int
        && data.updatedAt is int
        // Campos desnormalizados da account
        && data.accountType is string
        && (!data.keys().hasAny(['categoryId']) || data.categoryId is string)
        && (!data.keys().hasAny(['merchant']) || data.merchant is string)
        && (!data.keys().hasAny(['tags']) || data.tags is list)
        && (!data.keys().hasAny(['installmentGroupId']) || data.installmentGroupId is string)
        && (!data.keys().hasAny(['installmentNumber']) || data.installmentNumber is int)
        && (!data.keys().hasAny(['installmentCount']) || data.installmentCount is int)
        && (!data.keys().hasAny(['statementMonth']) || data.statementMonth is string);
    }

    // Valida que campos imutáveis de transaction não foram alterados
    function transactionImmutableFieldsUnchanged() {
      return request.method != 'update' || (
        resource.data.userId == request.resource.data.userId
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.date == request.resource.data.date
      );
    }

    match /transactions/{id} {
      // CREATE: precisa pertencer ao usuário, referenciar uma account do usuário e ter campos válidos
      allow create: if isOwnerNew()
        && accountBelongsToUser(request.resource.data.accountId)
        && hasRequiredTransactionFields(request.resource.data);

      // READ: só o dono
      allow read: if isOwnerDoc();

      // UPDATE: dono, userId imutável, conta referenciada continua do usuário e campos válidos
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && transactionImmutableFieldsUnchanged()
        && accountBelongsToUser(request.resource.data.accountId)
        && hasRequiredTransactionFields(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Installment Groups (opcional) -------------------- */

    // Valida campos obrigatórios de installment group
    function hasRequiredInstallmentGroupFields(data) {
      return data.keys().hasAll(['userId', 'description', 'totalAmount', 'installmentCount', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.description is string
        && data.description.size() >= 1
        && data.totalAmount is int
        && data.installmentCount is int
        && data.installmentCount >= 2
        && data.installmentCount <= 120
        && data.createdAt is int
        && data.updatedAt is int
        && (!data.keys().hasAny(['accountId']) || data.accountId is string)
        && (!data.keys().hasAny(['startDate']) || data.startDate is int);
    }

    // Valida que campos imutáveis de installment group não foram alterados
    function installmentGroupImmutableFieldsUnchanged() {
      return request.method != 'update' || (
        resource.data.userId == request.resource.data.userId
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.installmentCount == request.resource.data.installmentCount
      );
    }

    match /installment_groups/{id} {
      allow create: if isOwnerNew()
        && hasRequiredInstallmentGroupFields(request.resource.data);

      allow read: if isOwnerDoc();

      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && installmentGroupImmutableFieldsUnchanged()
        && hasRequiredInstallmentGroupFields(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Statements (credit card invoices) -------------------- */

    // Valida status de statement permitidos
    function isValidStatementStatus(status) {
      return status in ['open', 'closed', 'paid'];
    }

    // Valida campos obrigatórios de statement
    function hasRequiredStatementFields(data) {
      return data.keys().hasAll(['userId', 'accountId', 'statementMonth', 'closingDate', 'dueDate', 'status', 'totalAmount', 'minimumPayment', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.accountId is string
        && data.statementMonth is string
        && data.statementMonth.size() == 6 // YYYYMM format
        && data.closingDate is int
        && data.dueDate is int
        && isValidStatementStatus(data.status)
        && data.totalAmount is int
        && data.minimumPayment is int
        && data.createdAt is int
        && data.updatedAt is int
        && (!data.keys().hasAny(['paidAmount']) || data.paidAmount is int)
        && (!data.keys().hasAny(['paidAt']) || data.paidAt is int)
        && (!data.keys().hasAny(['transactionIds']) || data.transactionIds is list);
    }

    // Valida que campos imutáveis de statement não foram alterados
    function statementImmutableFieldsUnchanged() {
      return request.method != 'update' || (
        resource.data.userId == request.resource.data.userId
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.accountId == request.resource.data.accountId
        && resource.data.statementMonth == request.resource.data.statementMonth
      );
    }

    match /statements/{id} {
      allow create: if isOwnerNew()
        && accountBelongsToUser(request.resource.data.accountId)
        && hasRequiredStatementFields(request.resource.data);

      allow read: if isOwnerDoc();

      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && statementImmutableFieldsUnchanged()
        && accountBelongsToUser(request.resource.data.accountId)
        && hasRequiredStatementFields(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Categories / Budgets / Goals / Insights -------------------- */

    // Valida tipos de categoria permitidos
    function isValidCategoryType(type) {
      return type in ['expense', 'income', 'transfer'];
    }

    // Valida campos obrigatórios de category
    function hasRequiredCategoryFields(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && isValidCategoryType(data.type)
        && data.createdAt is int
        && data.updatedAt is int
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() == 7)) // #RRGGBB
        && (!data.keys().hasAny(['parentId']) || data.parentId is string)
        && (!data.keys().hasAny(['keywords']) || (data.keywords is list && data.keywords.size() <= 50))
        && (!data.keys().hasAny(['budgetLimit']) || data.budgetLimit is int)
        && (!data.keys().hasAny(['isSystem']) || data.isSystem is bool)
        && (!data.keys().hasAny(['order']) || data.order is int);
    }

    match /categories/{id} {
      allow create: if isOwnerNew()
        && hasRequiredCategoryFields(request.resource.data);

      allow read: if isOwnerDoc();

      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && hasRequiredCategoryFields(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Mapping Rules (auto-classification) -------------------- */

    // Valida prioridade de regra permitida
    function isValidRulePriority(priority) {
      return priority in ['low', 'medium', 'high'];
    }

    // Valida campos obrigatórios de mapping rule
    function hasRequiredMappingRuleFields(data) {
      return data.keys().hasAll(['userId', 'name', 'conditions', 'actions', 'priority', 'enabled', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.conditions is list
        && data.conditions.size() >= 1
        && data.conditions.size() <= 10
        && data.actions is list
        && data.actions.size() >= 1
        && data.actions.size() <= 5
        && isValidRulePriority(data.priority)
        && data.enabled is bool
        && data.createdAt is int
        && data.updatedAt is int
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['categoryType']) || isValidCategoryType(data.categoryType))
        && (!data.keys().hasAny(['usageCount']) || data.usageCount is int)
        && (!data.keys().hasAny(['lastUsedAt']) || data.lastUsedAt is int);
    }

    match /mapping_rules/{id} {
      allow create: if isOwnerNew()
        && hasRequiredMappingRuleFields(request.resource.data);

      allow read: if isOwnerDoc();

      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && hasRequiredMappingRuleFields(request.resource.data);

      allow delete: if isOwnerDoc();
    }

    /* -------------------- Budgets / Goals / Insights -------------------- */

    match /budgets/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    match /goals/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    match /insights/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    /* -------------------- AI chat (sessions & messages) -------------------- */
    match /ai_sessions/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    match /ai_messages/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    /* -------------------- Investments -------------------- */
    // Contas de investimento
    match /investment_accounts/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    // Posições (snapshot agregado)
    match /investment_positions/{id} {
      allow create: if isOwnerNew()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow delete: if isOwnerDoc();
    }

    // Movimentações
    match /investment_transactions/{id} {
      allow create: if isOwnerNew()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow delete: if isOwnerDoc();
    }

    // Rendimentos / proventos
    match /investment_earnings/{id} {
      allow create: if isOwnerNew()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && invAccountBelongsToUser(request.resource.data.invAccountId);
      allow delete: if isOwnerDoc();
    }

    /* -------------------- Points (loyalty miles/pontos) -------------------- */
    // Cadastro do usuário em programas
    match /points_programs/{id} {
      allow create: if isOwnerNew();
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc() && isOwnerNew() && sameUserIdOnUpdate();
      allow delete: if isOwnerDoc();
    }

    // Saldos/lotes com expiração
    match /points_balances/{id} {
      allow create: if isOwnerNew()
        && pointsProgramBelongsToUser(request.resource.data.programId);
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && pointsProgramBelongsToUser(request.resource.data.programId);
      allow delete: if isOwnerDoc();
    }

    // Operações (earn, redeem, transfer)
    match /points_operations/{id} {
      allow create: if isOwnerNew()
        && pointsProgramBelongsToUser(request.resource.data.programId);
      allow read: if isOwnerDoc();
      allow update: if isOwnerDoc()
        && isOwnerNew()
        && sameUserIdOnUpdate()
        && pointsProgramBelongsToUser(request.resource.data.programId);
      allow delete: if isOwnerDoc();
    }

    // Ofertas de pontos (catálogo global)
    // - leitura pública (pode exibir na UI sem login se quiser)
    // - escrita apenas por admin (claim custom)
    match /points_offers/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* -------------------- Audit Events (observabilidade) -------------------- */
    // Audit events são write-only para o sistema (admin SDK)
    // Usuários podem apenas ler seus próprios eventos
    match /audit_events/{id} {
      // Apenas o dono pode ler seus próprios eventos de auditoria
      allow read: if isOwnerDoc();

      // Apenas o sistema (admin SDK) pode criar eventos de auditoria
      // Isso é enforced no código - usuários não devem criar eventos diretamente
      allow create: if false;

      // Ninguém pode atualizar ou deletar eventos de auditoria
      // Cleanup é feito pelo sistema via admin SDK
      allow update, delete: if false;
    }
  }
}
